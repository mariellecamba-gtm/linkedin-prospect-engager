# Copy this file to .env and fill it in, or just run: npm run setup
# .env is gitignored. Never commit real keys.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Your name. Only used to address the model. Every fact it is allowed to claim
# about you lives in config/about-me.md.
YOUR_NAME=

# Apify -- reads the prospects' posts (harvestapi/linkedin-profile-posts actor).
# https://console.apify.com -> Settings -> API & Integrations -> Personal API token
APIFY_API_KEY=

# One of these two. The model that drafts the comment and the DM.
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Optional: where the drafts land
# ---------------------------------------------------------------------------
# With none of this set, every run writes output/digest-<date>.md and stops.

# Google Sheet. The sheet must be shared (Editor) with the service account's
# client_email. See the README.
SHEET_ID=
# In GitHub Actions, paste the whole service-account JSON file into this secret.
GOOGLE_SERVICE_ACCOUNT_JSON=
# Locally, a path to that file is easier.
GOOGLE_SERVICE_ACCOUNT_FILE=

# A GitHub issue per day. Automatic in GitHub Actions when no sheet is set.
# PUBLISH_ISSUE=1        # always open one
# PUBLISH_ISSUE=0        # never open one
# GITHUB_TOKEN=          # only needed outside Actions; a PAT with repo scope
# GITHUB_REPOSITORY=you/your-repo

# A one-line Slack ping when the day's drafts are ready.
SLACK_BOT_TOKEN=
SLACK_CHANNEL=

# ---------------------------------------------------------------------------
# Optional knobs
# ---------------------------------------------------------------------------
# TIMEZONE=America/New_York   # which calendar day "yesterday" means
# MAX_POSTS_PER_PROFILE=3     # newest N posts per person per run
# MAX_DRAFTS=60               # cap on model calls per run, your cost ceiling
# MAX_COMMENT_CHARS=140       # hard length limit on a drafted comment
# POSTED_LIMIT=               # backfill only: any | 1h | 24h | week | month
# LOOKBACK_DAYS=1             # 1 = yesterday and today so far
# ANTHROPIC_MODEL=claude-sonnet-5
# OPENAI_MODEL=gpt-4o-mini
# DRAFT_PROVIDER=             # anthropic | openai, when both keys are set
# FEED_TAB=Feed
# SKIPPED_TAB=Skipped
# DRY_RUN=1                   # write nothing anywhere, just print
